{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "commonjs",
    "target": "es2022",
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {},
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
