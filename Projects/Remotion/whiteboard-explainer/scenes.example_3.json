    {
      "id": "t3-step-001",
      "type": "stepReveal",
      "durationInFrames": 609,
      "narration": "Start with two routes from A to B. The first runs twenty-five minutes of variable road, then forty-five fixed. The second mirrors it: forty-five fixed, then twenty-five variable. With drivers splitting evenly, each variable leg stays at twenty-five minutes — so every journey takes seventy minutes.",
      "transition": {
        "type": "fade",
        "durationInFrames": 20
      },
      "title": "Start with two equivalent routes",
      "body": [
        "Road 1: 25 minutes variable, then 45 minutes fixed",
        "Road 2: 45 minutes fixed, then 25 minutes variable",
        "The two routes are mirror images of each other",
        "Drivers split evenly, so each variable half stays at 25 minutes"
      ],
      "doodles": [
